{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/gw/:path*", "destination": "https://api.ocva.online/:path*" },
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ]
}