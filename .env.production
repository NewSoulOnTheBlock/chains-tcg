# Vite production environment for the Chains TCG client.
#
# Loaded by `npm run build`. Only `VITE_*` variables reach the browser bundle.
#
# On Vercel this file is the default; a dashboard Environment Variable of the
# same name overrides it, so set `VITE_API_BASE` there too if you ever point a
# preview deployment at a staging gateway.
#
# `src/api/config.ts` derives the rest:
#   API_BASE    = VITE_API_BASE                 every REST call
#   SOCKET_URL  = VITE_API_BASE                 the boardgame.io socket.io transport
#   RPC_URL     = VITE_API_BASE + /rpc/evm      the read-only JSON-RPC proxy
VITE_API_BASE=https://api.ocva.online

# The gateway must name this build's origin in its CORS allowlist, and its CSP
# (`default-src 'self'; script-src 'self'`) applies to the page — see
# INTEGRATION.md §6 for the third-party scripts that will be blocked.
#
# No RPC credential belongs in this file. See `.env.development` for why.
