# legacy-peer-deps is REQUIRED — `npm install` without it fails with ERESOLVE.
# Two real peer conflicts exist against the project's pinned versions:
#   1. @react-three/drei@10 lists react@^19 as a peer, but the app is on
#      react@18.3.x (drei works on 18 in practice).
#   2. @google/model-viewer@3.5 pins three@^0.163.0, but the app uses
#      three@0.184.0 (and @react-three/* track the newer three).
# Dropping this line was tried during the 2026-11-01 cleanup and reverted
# because the install breaks. Revisit if model-viewer/drei are upgraded or
# removed.
legacy-peer-deps=true
