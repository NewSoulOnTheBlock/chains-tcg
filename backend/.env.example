# Chains TCG backend — environment. Every variable has a working default, so
# `docker compose up --build` runs with zero configuration. Copy to `.env`
# only if you need to override something.

# Password for the `chains` postgres user (default: chains).
POSTGRES_PASSWORD=chains

# Extra comma-separated origins allowed to hit the game server's REST/socket
# surface, e.g. https://play.example.com. localhost:3000 is always allowed.
ALLOW_ORIGIN=
