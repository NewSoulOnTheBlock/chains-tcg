# ---------------------------------------------------------------------------
# Chains TCG secure backend — environment
#
#   cp .env.example .env    (or: make env, which fills the secrets for you)
#
# Every variable marked REQUIRED has no default anywhere in the stack. If it is
# missing, `docker compose` refuses to render and the service refuses to boot.
# That is deliberate: the previous backend booted happily with a placeholder
# secret, which is how a development key reaches production.
#
# Nothing in this file may ever be committed with real values. `.env` is
# gitignored; `.env.example` is the only file that belongs in git.
# ---------------------------------------------------------------------------

# ============================ core secrets =================================

# REQUIRED. HS256 signing key for access tokens. Minimum 32 characters —
# the shared env schema rejects anything shorter.
#   openssl rand -hex 32
JWT_SECRET=

# REQUIRED. Postgres superuser password for the compose-managed database.
#   openssl rand -base64 24 | tr -d '=+/'
POSTGRES_PASSWORD=

# REQUIRED. HMAC key the game service signs each `game.match_results` row with
# and the wager service verifies before releasing money. Both services must
# hold the same value; nothing else may. (audit finding C-1)
#   openssl rand -hex 32
MATCH_RESULT_HMAC_SECRET=

# ============================ CORS / origins ===============================

# REQUIRED. Comma-separated browser origins allowed to call the API.
# NEVER '*' — the gateway entrypoint exits non-zero if it sees one.
# Include the scheme and port exactly as the browser sends them.
#
# The API lives on a DIFFERENT host from the web app
# (api.ocva.online vs ocva.online), so every browser call is cross-origin and
# CORS must name the exact web origins below. Tokens travel in the
# `Authorization: Bearer` header, never in cookies — there is no shared cookie
# domain to rely on and nothing here is SameSite-protected.
#
# Each origin is listed IN FULL. Never a wildcard and never a suffix pattern —
# `*.vercel.app` would let literally any site hosted on Vercel call this API,
# which is the whole point of an allowlist gone. Add the specific hostname.
#
# For local development append your dev server, e.g.:
#   ALLOWED_ORIGINS=https://ocva.online,https://www.ocva.online,http://localhost:5173
ALLOWED_ORIGINS=https://ocva.online,https://www.ocva.online,https://chains-tcg.vercel.app

# The domain and URI embedded in the message wallets are asked to sign.
# These bind a signature to this deployment: a signature phished for another
# domain will not verify here.
#
# SECURITY: AUTH_DOMAIN comes from THIS variable and nothing else. It is never
# derived from the request's Host or Origin header — if it were, any site could
# ask a wallet to sign "evil.example wants you to sign in…" and replay the
# result here. `/auth/verify` additionally refuses a stored nonce whose domain
# does not equal the current AUTH_DOMAIN, so rotating this value invalidates
# challenges minted under the old one instead of accepting both.
#
# It is the WEB APP's origin, not the API's: that is the domain the user sees
# in their wallet prompt.
AUTH_DOMAIN=ocva.online
AUTH_URI=https://ocva.online
AUTH_STATEMENT=Sign in to Chains TCG.

# ============================ RPC (server-side only) =======================
# H-5: this holds the real API key and exists ONLY inside the rpc-proxy
# container. It is never injected into the browser bundle — the frontend calls
# /rpc/evm instead.
#
# CHAIN SCOPE IS EVM-ONLY. The Anchor program under solana/ was never deployed,
# so there is no SOLANA_RPC_URL and no SOLANA_CLUSTER anywhere in this stack.
# Solana *login signature* verification still works (auth service, ed25519) —
# that is a local crypto check, not a chain call, and needs no RPC endpoint.

# REQUIRED for the full stack (not needed for postgres+redis+migrate+auth).
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional JSON-RPC method allowlist for the proxy, comma-separated.
# Empty means the rpc-proxy service applies its own default allowlist.
# It can only NARROW the built-in allowlist, never widen it, and
# eth_sendRawTransaction is not in the built-in list at all.
RPC_ALLOWED_METHODS=

# Optional. Shared secret the wager service presents to the rpc-proxy. It buys
# a higher rate-limit tier and NOTHING else — a leak cannot become a broadcast
# path. Empty disables the internal tier. Reaches rpc-proxy as
# RPC_INTERNAL_TOKEN and wager as RPC_PROXY_INTERNAL_TOKEN.
#   openssl rand -hex 32
RPC_PROXY_INTERNAL_TOKEN=

# ============================ wager: keys (H-4) ============================
# REQUIRED, and they MUST be two DIFFERENT keys. The wager escrow holds player
# stakes; the booster treasury receives shop revenue. The legacy code fell back
# to one hot wallet for both, so compromising the shop key drained every open
# wager. `loadKeys()` compares the derived addresses and refuses to start if
# they match.
#
# NEVER put a real key in this file. Generate throwaway dev keys with:
#   printf '0x%s\n' "$(openssl rand -hex 32)"      # once per variable
# For anything holding real money use a hardware signer or a KMS, not env.
WAGER_ESCROW_KEYPAIR=
BOOSTER_TREASURY_KEYPAIR=

# REQUIRED. Seeds the deterministic booster pack roll, so a retried redemption
# re-derives the same pack instead of re-rolling it.
#   openssl rand -hex 32
BOOSTER_PACK_SEED_SECRET=

# ============================ wager: EVM payout path =======================
# Payouts are SIGNED here and broadcast here. They cannot go through the
# rpc-proxy: the proxy refuses eth_sendRawTransaction on purpose (H-5), so a
# leaked proxy credential is never a broadcast path.
EVM_SUBMIT_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EVM_CHAIN_ID=11155111
# Blocks a deposit must have before it counts.
EVM_MIN_CONFIRMATIONS=2

# ============================ wager: amount policy =========================
# The ERC-20 the escrow accepts, lower-case. Deposits in any other token are
# rejected. Default below is Sepolia USDC — CHANGE IT for any other network.
WAGER_TOKEN_ADDRESS=0x1c7d4b196cb0c7b01d743fbc6116a902379c7238
WAGER_TOKEN_DECIMALS=6

# REQUIRED shape: comma-separated integers in BASE units (not decimals).
# This is the server-side amount allowlist. A client names a TIER INDEX and can
# never name an amount, so no request body decides how much money moves.
# The default is 1 / 5 / 25 USDC at 6 decimals.
WAGER_STAKE_TIERS_BASE=1000000,5000000,25000000

# Optional. Protocol cut, in basis points, sent to the burn address as an
# ordinary payout leg. 1000 = 10%. Set WAGER_BURN_BPS=0 to disable.
WAGER_BURN_ADDRESS=0x000000000000000000000000000000000000dead
WAGER_BURN_BPS=1000

# ============================ wager: booster shop ==========================
# Optional. Booster price in wei of the NATIVE currency.
BOOSTER_PRICE_WEI=3500000000000000
BOOSTER_SUPPLY_CAP=2000

# Optional. Comma-separated card ids a digital redemption may roll. EMPTY on
# purpose: with no pool the route answers 503 rather than inventing card ids.
BOOSTER_CARD_POOL=

# ============================ wager: settlement ============================
SETTLEMENT_ENABLED=true
SETTLEMENT_POLL_MS=5000

# ============================ operators ====================================
# Comma-separated `chain:address` pairs (a bare address matches on any chain).
# This list is the ONLY source of the `operator` role — it is never read from
# the database, so a database write cannot grant privilege. (audit finding L-1)
#   OPERATOR_ADDRESSES=solana:7xKX...q4Rt,ethereum:0xabc...123
OPERATOR_ADDRESSES=

# ============================ database =====================================

POSTGRES_USER=chains
POSTGRES_DB=chains
# Host-side port, bound to 127.0.0.1 only. Production publishes nothing but the gateway.
POSTGRES_PORT=5432
PGPOOL_MAX=10

# ============================ redis ========================================

REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

# ============================ tokens / sessions ============================

# Access token lifetime, seconds (60–3600). Short by design.
ACCESS_TOKEN_TTL_SEC=900
# Refresh token lifetime, seconds. 30 days. Rotation does not extend it.
REFRESH_TOKEN_TTL_SEC=2592000
# Sign-in challenge lifetime, seconds (30–900).
NONCE_TTL_SEC=300

JWT_ISSUER=chains-auth
JWT_AUDIENCE=chains-api

# ============================ runtime ======================================

NODE_ENV=production
LOG_LEVEL=info
# Proxy hops to trust for req.ip. The gateway is exactly one.
TRUST_PROXY_HOPS=1
SHUTDOWN_GRACE_MS=10000

# Host-side ports, all bound to 127.0.0.1 for local debugging.
GATEWAY_PORT=8080
AUTH_PORT=4001
PROFILE_PORT=4002
GAME_PORT=4003
WAGER_PORT=4004
RPC_PROXY_PORT=4005
