{
  "name": "@chains/rpc-proxy",
  "version": "2.0.0",
  "private": true,
  "description": "Chains TCG rpc-proxy — the only holder of RPC credentials; read-only JSON-RPC for the browser and for internal services (:4005)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@chains/shared": "file:../../packages/shared",
    "express": "^5.2.1",
    "redis": "^5.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  }
}
