{
  // Typecheck project for the Vercel functions under api/ (api/chat.ts,
  // api/presence.ts). The browser tsconfig only covers `src`, so without this
  // the pg-backed functions ship through esbuild with no type checking at all
  // (hygiene-07). They use the Web fetch/Request/Response globals, so DOM libs
  // stay on; Node built-ins (node:crypto) need the node types.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"]
  },
  "include": ["api"]
}
