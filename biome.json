{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "ignore": [
      "node_modules",
      "dist",
      ".vite",
      ".vercel",
      "coverage",
      "public",
      "new-backend",
      "solana",
      "contracts",
      "docs",
      "*.tsbuildinfo"
    ]
  },
  "organizeImports": { "enabled": false },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": { "enabled": false }
  }
}
