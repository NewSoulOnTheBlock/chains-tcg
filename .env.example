# Local development environment for the root app (Vite client + Koa/boardgame.io server).
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.

# ── Server ───────────────────────────────────────────────────────────────────
# Port the game server listens on (Vite proxies /api /games /socket.io here).
PORT=8000

# Postgres for profiles, decks, match results, challenges and booster tickets.
# Without it the server keeps everything in memory and loses it on restart.
# Local dev container (see README → Local development):
#   docker run -d --name chains-dev-pg -p 5433:5432 \
#     -e POSTGRES_USER=chains -e POSTGRES_PASSWORD=chains -e POSTGRES_DB=chains \
#     -v chains-dev-pgdata:/var/lib/postgresql/data postgres:16-alpine
DATABASE_URL=postgres://chains:chains@localhost:5433/chains

# Set to 1 when the database requires SSL (managed Postgres in production).
# PGSSL=1

# Comma-separated extra origins allowed to reach the REST API and socket.io.
# Localhost is always allowed in development.
# ALLOW_ORIGIN=https://www.masterstcg.com,https://masterstcg.com

# Guards the admin-only refund endpoint. Generate with: openssl rand -hex 32
# ADMIN_TOKEN=

# ── Chain access (server-side only — never expose these to the client) ───────
# SOLANA_RPC=
# HELIUS_API_KEY=
# CUSTODIAL_ESCROW_KEYPAIR=
# BOOSTER_TREASURY_KEYPAIR=
